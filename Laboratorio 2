/// *********************************************************************************************************************
/// PARTE 2 - TEMPORIZADOR SIN USO DE BOTONES 
/// *********************************************************************************************************************

#define alarma 250000 // micro 250ms
// *****************************************************************
// PROTOTIPOS DE FUNCIONES
// ************************************************************************

void Timer(void);
void mostrarContadorAuto(void);
void IRAM_ATTR Timer0_ISR();

// *******************************
// VARIABLES GLOBALES
// *******************************

hw_timer_t *Timer0_cfg = NULL;

// Contador automático de 0 a 15
volatile int contadorAuto = 0;


// **********************************************************************************
// CONFIGURACIÓN.  Setup ()
// ***********************************************************************************

void setup()
{
// ----------------------------------------------------------------------------
//                           PARTE 1 BOTONES
// -----------------------------------------------------------------------------

// Para leds  botones ---------

pinMode(led5,OUTPUT);
pinMode(led6,OUTPUT);
pinMode(led7,OUTPUT);
pinMode(led8,OUTPUT);

// Para botones ------- 
pinMode(b1,INPUT); // incre 
pinMode(b2,INPUT); // decre 

attachInterrupt(b1, Subir, RISING);
attachInterrupt(b2, Bajar, RISING);
 
  mostrarContadorBoton(0);

  // ----------------------------------------------------------------------------
  //                           PARTE 2 TIMER 
  // -----------------------------------------------------------------------------
  // Configurar los LEDs  como salidas Parte 2 Timer 
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);

  // Apagar leds 
  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);
  digitalWrite(led3, LOW);
  digitalWrite(led4, LOW);

  // Configurar el temporizador
  Timer();
}
//,---------------------------------------------------------------------------------------------
// ***************************************************************************************
// LOOP
// ***************************************************************************************
void loop()
{
// ----------------------------------------------------------------------------
//                           PARTE 1 BOTONES
// -----------------------------------------------------------------------------
uint8_t valorActual;
  portENTER_CRITICAL(&candadoBoton);
  valorActual = contadorBoton;
  portEXIT_CRITICAL(&candadoBoton);
  mostrarContadorBoton(valorActual);
// ----------------------------------------------------------------------------
//                           PARTE 2 TIMER 
// -----------------------------------------------------------------------------
  mostrarContadorAuto();
}

// ********************************************************************************************
//.  INTERRUPCIÓN DEL TEMPO
// *********************************************************************************************

void IRAM_ATTR Timer0_ISR()
{
  // Cada 250 ms aumenta el contador
  contadorAuto++;

  // Contador circular
  // Si pasa de 15, vuelve a 0
  if (contadorAuto > 15)
  {
    contadorAuto= 0;
  }
}

// *******************************
// FUNCIÓN PARA MOSTRAR EL CONTADOR de Leds 
// *******************************

void mostrarContadorAuto()
{
  if (contadorAuto == 0)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 1)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 2)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 3)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 4)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 5)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 6)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 7)
  {
    digitalWrite(led4, LOW);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 8)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 9)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 10)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, LOW);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 11)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, LOW);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 12)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 13)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led1, HIGH);
  }

  else if (contadorAuto == 14)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, LOW);
  }

  else if (contadorAuto == 15)
  {
    digitalWrite(led4, HIGH);
    digitalWrite(led3, HIGH);
    digitalWrite(led2, HIGH);
    digitalWrite(led1, HIGH);
  }
}

// *******************************
// CONFIGURACIÓN DEL TEMPORIZADOR
// *******************************

void Timer(void)
{
  // Timer 0, prescaler 80, conteo ascendente
  Timer0_cfg = timerBegin(0, 80, true);

  // Asociar la interrupción del timer
  timerAttachInterrupt(Timer0_cfg, &Timer0_ISR, true);

  // Activar alarma cada 250000 microsegundos
  timerAlarmWrite(Timer0_cfg, alarma, true);

  // Iniciar la alarma
  timerAlarmEnable(Timer0_cfg);
}

