#include <Arduino.h>

//*********************************************************************//
// Definicon de pines // 
//*********************************************************************//

// leds timer 
const int led1 = 23;
const int led2 = 18;
const int led3 = 21;
const int led4 = 19;

// Leds botones 
const int led5 = 32;
const int led6 = 25;
const int led7 = 14;
const int led8 = 33;

// led alarma 
const int led9 = 27;

// Botones 

const int b1 = 22;// boton 1 incrementar 
const int b2 = 4;// boton 2  decrementar 

// Contador de 4 bits 
volatile uint8_t contadorBoton = 0;

// Variables de anti-rebote para boton
volatile uint32_t tiempoSubir = 0;
volatile uint32_t tiempoBajar = 0;
const uint32_t antirebote = 200; // mS entre pulsaciones válidas


/// *********************************************************************************************************************
///  PARTE 1 - CONTADOR MEDIANTE INTERRUOCIONES 
/// *********************************************************************************************************************
//  proteger contadorBoton cuando se lee/escribe
// desde la ISR y desde el loop() al mismo tiempo.
portMUX_TYPE candadoBoton = portMUX_INITIALIZER_UNLOCKED;


// ---- Definición de Funciones -------------
void mostrarContadorBoton(uint8_t valor);
 
// ---- Interrupciones  -----------------------
 
// ISR de B1: incrementa el contador
void IRAM_ATTR Subir() {
  uint32_t ahora = millis();
  if (ahora - tiempoSubir > antirebote) {
    portENTER_CRITICAL_ISR(&candadoBoton);
    contadorBoton = (contadorBoton + 1) % 16; // circular: 15 -> 0
    portEXIT_CRITICAL_ISR(&candadoBoton);
    tiempoSubir = ahora;
  }
}
 
// ISR de B2: decrementa el contador
void IRAM_ATTR Bajar() {
  uint32_t ahora = millis();
  if (ahora - tiempoBajar > antirebote) {
    portENTER_CRITICAL_ISR(&candadoBoton);
    contadorBoton = (contadorBoton + 15) % 16; // circular: 0 -> 15 (equivale a -1)
    portEXIT_CRITICAL_ISR(&candadoBoton);
    tiempoBajar = ahora;
  }
}
 
// Muestra el valor del contador en los 4 LEDs (binario)
void mostrarContadorBoton(uint8_t valor) {
  digitalWrite(led5, bitRead(valor, 0));
  digitalWrite(led6, bitRead(valor, 1));
  digitalWrite(led7, bitRead(valor, 2));
  digitalWrite(led8, bitRead(valor, 3));
}
 
