// Librerias //
#include <Arduino.h>
#include <stdint.h>

//*********************************************************************//

// Parte 1 y 2: CONTADOR BINARIO y Decadas //

//*********************************************************************//

// Variables globales

// cada led representa un bit del contador
const int led1 = 14;
const int led2 = 13;
const int led3 = 15;
const int led4 = 18;

// botones
const int botonincre = 22; // Botón con pull-down externo
const int botondecre = 23; // Botón con pull-up externo
const int botonmodo = 21;  // Botón con pull-up interno

int contador = 0;   // Se guarda el valor actual.
int modo = 0;       // 0 = decadas y 1 = binario
int salidaModo = 0; // Guarda si el botón de modo fue presionado

//*********************************************************************//
// Funciones

// Muestra y lee el estado y el valor de los leds mediante el contador
void mostrarcontador() {
  digitalWrite(led1, bitRead(contador, 0));
  digitalWrite(led2, bitRead(contador, 1));
  digitalWrite(led3, bitRead(contador, 2));
  digitalWrite(led4, bitRead(contador, 3));
}

// numero de 4 bits es de 0 a 15
void increcontador() {
  contador++; // para sumar uno al contador

  // modo decadas de 9 a 0
  if (modo == 0 && contador > 9) {
    contador = 0;
  }

  // modo binario de 15 a 0
  if (modo == 1 && contador > 15) {
    contador = 0;
  }

  mostrarcontador();
}

// decrementa contador
void decrecontador() {
  contador--; // para restar uno al contador

  // Modo decadas
  if (modo == 0 && contador < 0) {
    contador = 9;
  }

  // Modo binario
  if (modo == 1 && contador < 0) {
    contador = 15;
  }

  mostrarcontador();
}

// Botón de modo.
// Con PULLUP interno: presionado = LOW y suelto = HIGH.
void cambiarmodo() {
  int estadoModo = digitalRead(botonmodo); // Lee el botón de modo.
  delay(15); // anti-rebote.

  estadoModo = digitalRead(botonmodo); // Confirma el estado después del delay.

  // Guarda que el botón fue presionado.
  if (estadoModo == LOW) {
    salidaModo = 1;
  }

  // Cambia de modo cuando el botón ya fue soltado.
  if (salidaModo == 1 && estadoModo == HIGH) {
    modo++; // Cambia al siguiente modo.

    // Solo hay dos modos: 0 y 1.
    if (modo > 1) {
      modo = 0;
    }

    contador = 0;      // Reinicia el contador al cambiar de modo.
    salidaModo = 0;    // Prepara para leer otra pulsación.
    mostrarcontador(); // Muestra cero en los LEDs.
    delay(15);         // anti-rebote
  }
}

//*********************************************************************//
// Set up

void setup() {
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);

  // Los botones incrementar y decrementar tienen resistencias externas.
  pinMode(botonincre, INPUT);
  pinMode(botondecre, INPUT);

  // El botón de modo 
  pinMode(botonmodo, INPUT_PULLUP);

  mostrarcontador();
}

//*********************************************************************//
// loop

void loop() {
  cambiarmodo(); // para revisar botón de modo

  // Pull-down: el botón se detecta presionado cuando se lee HIGH.
  if (digitalRead(botonincre) == HIGH) {
    delay(100); // anti-rebote

    if (digitalRead(botonincre) == HIGH) {
      increcontador();

      // Espera hasta que el botón sea soltado.
      while (digitalRead(botonincre) == HIGH) {
        delay(10);
      }
    }
  }

  // Pull-up: el botón se detecta presionado cuando se lee LOW.
  if (digitalRead(botondecre) == LOW) {
    delay(100); // anti-rebote

    if (digitalRead(botondecre) == LOW) {
      decrecontador();

      // Espera hasta que el botón sea soltado.
      while (digitalRead(botondecre) == LOW) {
        delay(10);
      }
    }
  }
}

